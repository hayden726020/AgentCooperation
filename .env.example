# Save a local copy as .env and fill keys there. Never send keys in chat.
# Requested integration order: DeepSeek first, then GLM.
DEEPSEEK_API_KEY=
GLM_API_KEY=

# Google subscription review now uses Antigravity CLI; legacy Gemini CLI remains selectable.
# Leave GEMINI_API_KEY empty to avoid switching to API-key billing.
GEMINI_API_KEY=

# Optional executable commands. The pinned repo-local Gemini install is
# discovered automatically when the default command is not on PATH.
GEMINI_CLI_CMD=gemini
CODEX_CLI_CMD=codex
ANTIGRAVITY_CLI_CMD=agy
ANTIGRAVITY_REVIEW_MODEL=gemini-3.8-flash-high
ANTIGRAVITY_REVIEW_EFFORT=high
GEMINI_REVIEW_MODEL=gemini-3.8-flash-high
GEMINI_REVIEW_EFFORT=high
CODEX_EXPERT_MODEL=gpt-6.1-sol

# For paths with arguments, use JSON argv arrays, never a shell command.
# GEMINI_CLI_ARGV_PREFIX=["E:/Node/node.exe","E:/AgentCooperation/.runtime/gemini/node_modules/@google/gemini-cli/bundle/gemini.js"]
